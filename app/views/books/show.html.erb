<p><%= link_to "Back", books_path %></p>

<section class="book">
  <section class="book-info">
    <% cache @book do %>
      <h1 class="text-blue-800"><%= @book.name %></h1>
      <h3><%= "Price: #{@book.price}" %></h3>
    <% end %>

    <% unless @book.author.nil? %>
      <h3>Author: <%= link_to @book.author.name, @book.author %></h3>
    <% end %>

    <%= @book.description %>
    <%= render "inventory", book: @book %>

    <% if authenticated? %>
      <%= link_to "Edit", edit_book_path(@book) %>
      <%= button_to "Delete", @book, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
    <% end %>
  </section>
</section>

