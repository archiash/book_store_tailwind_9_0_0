<div class="flex flex-row">
  <div class="w-full flex-row flex">
    <%= link_to "Back", books_path %>
  </div>
  <div class="w-full flex-row-reverse flex gap-4">
    <% if authenticated? %>
      <%= button_to "Delete", @book, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "cursor-pointer text-red-500" %>
      <%= link_to "Edit", edit_book_path(@book) %>
    <% end %>
  </div>
</div>

<section class="book w-full">
  <section class="book-info w-full">
    <% cache @book do %>
      <div class="flex flex-row">
      <h1 class="text-slate-600 text-3xl font-semibold"><%= @book.name %></h1>
      </div>
      <h3 class="font-bold text-slate-800 text-lg"><%= "Price: #{@book.price}" %></h3>
    <% end %>

    <% unless @book.authors.nil? %>
      <h3 class="font-bold text-slate-800 text-lg">Author:
        <% @book.authors.each_with_index do |author, index| %>
          <%= link_to author.name, author %>
          <%=", " if index < @book.authors.count - 1 %>  
       <% end %>
      </h3>
    <% end %>

    <div class="font-bold text-slate-800 text-lg">Description</div>
    <%= @book.description %>

    <div class="font-bold text-slate-800 text-lg">
      <%= render "inventory", book: @book %>
    </div>

    <div>
      <div class="font-bold text-slate-800 text-lg">Reviews</div>
      <% @book.reviews.each do |review| %>
        <div class="bg-slate-400 w-full m-2 p-2">
          <div class="flex flex-col">
            <div class="font-semibold"><%= review.user.name %></div>
            <%= review.description %>
          </div>
        </div>
      <% end %>
    </div>

  </section>
</section>

