<p><%= link_to "Back", books_path %></p>

<section class="book">
  <section class="book-info">
    <% cache @book do %>
      <h1 class="text-slate-600 text-3xl font-semibold"><%= @book.name %></h1>
      <h3 class="font-bold text-slate-800"><%= "Price: #{@book.price}" %></h3>
    <% end %>

    <% unless @book.authors.nil? %>
      <h3 class="font-bold text-slate-800">Author:
        <% @book.authors.each_with_index do |author, index| %>
          <%= link_to author.name, author %>
          <%=", " if index < @book.authors.count - 1 %>  
       <% end %>
      </h3>
    <% end %>

    <div class="font-bold text-slate-800">Description</div>
    <%= @book.description %>
    <div class="font-bold text-slate-800"><%= render "inventory", book: @book %></div>

    <% if authenticated? %>
      <%= link_to "Edit", edit_book_path(@book) %>
      <%= button_to "Delete", @book, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "cursor-pointer text-red-500" %>
    <% end %>
  </section>
</section>

