<h1 class="text-3xl text-slate-600 font-semibold">Books</h1>

<%= link_to "New book", new_book_path if authenticated? %>

<div id="books">
  <% @books.each do |book| %>
    <div>
      <%= link_to book.name, book %>
      ,price <%= book.price %>
      <% unless book.authors.nil? %>
        ,by <% book.authors.each do |author|%>
        <%= author.name %>
      <% end %>
      <% end %>
    </div>
  <% end %>
</div>
