<h1 class="text-3xl text-slate-600 font-semibold">Books</h1>

<%= link_to "Login", new_session_path unless authenticated? %>
<%= link_to "New book", new_book_path if authenticated? %>

<div id="books">
  <% @books.each do |book| %>
    <div>
      <%= link_to book.name, book %>
      ,price <%= book.price %>
      <% unless book.author.nil? %>
        ,by <%= book.author.name %>
      <% end %>
    </div>
  <% end %>
</div>
