<%= form_with model: book do |form| %>
  <div class="flex flex-col gap-2">
    <% if form.object.errors.any? %>
      <p class="error">
        <%= form.object.errors.full_message.first %>
      </p>
    <% end %>

    <div>
      <%= form.label :name %>
      <%= form.text_field :name %>
    </div>

    <div> 
      <%= form.label :price %>
      <%= form.number_field :price, step: 1 %>
    </div>

    <div>
      <%= form.label :author %>
      <%= form.collection_select :author_id, Author.all, :id, :name, { include_blank: "None" } %>
    </div>

    <div>
      <%= form.label :inventory_count, style: "display: block" %>
      <%= form.number_field :inventory_count %>
    </div>

    <div>
      <%= form.label :description, style: "display: block" %>
      <%= form.rich_textarea :description %>
    </div>

    <div>
      <%= form.submit %>
    </div>
  </div>
<% end %>
