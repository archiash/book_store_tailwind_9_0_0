<%= form_with model: book do |form| %>
  <div class="flex flex-col gap-2 my-4">
    <% if form.object.errors.any? %>
      <p class="error">
        <%= form.object.errors.full_message.first %>
      </p>
    <% end %>

    <div>
      <%= form.label :name %>
      <%= form.text_field :name %>
    </div>

    <div> 
      <%= form.label :price %>
      <%= form.number_field :price, step: 1 %>
    </div>

    <div class="flex fles-row gap-2">
      <%= form.label :authors %>

      <div class="flex flex-col gap-2">
        <%= form.collection_check_boxes :author_ids, Author.all, :id, :name do |author| %>
          <%= author.label { author.check_box + " " + author.text } %>
        <% end %>
      </div>
    </div>

    <div>
      <%= form.label :inventory_count %>
      <%= form.number_field :inventory_count %>
    </div>

    <div>
      <%= form.label :description, style: "display: block" %>
      <%= form.rich_textarea :description %>
    </div>

    <div>
      <%= form.submit %>
    </div>
  </div>
<% end %>
