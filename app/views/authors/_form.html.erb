<%= form_with model: author do |form| %>
  <% if form.object.errors.any? %> 
    <p class="error">
      <%= form.obeject.errors.full_meesage.first %>
    </p>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
