<%= form_with model: author do |form| %>
  <div class="flex flex-col gap-2 my-4">
    <% if form.object.errors.any? %> 
      <p class="error">
        <%= form.obeject.errors.full_meesage.first %>
      </p>
    <% end %>

    <div>
      <%= form.label :name, class: "text-slate-800 text-xl" %>
      <%= form.text_field :name %>
    </div>

    <div>
      <%= form.submit %>
    </div>
  </div>
<% end %>
